{
  "manifest_version": "1.0",
  "plugin_api_version": "1.0",
  "plugin": {
    "plugin_id": "axdata.collector.exchange",
    "name_zh": "交易所采集器",
    "version": "0.1.0",
    "description": "交易所采集器插件:按接口目录自动生成独立采集器。"
  },
  "provider": null,
  "interfaces": [],
  "downloaders": [],
  "collectors": [
    {
      "collector_id": "exchange.stock_basic_info_exchange.snapshot",
      "name": "exchange.stock_basic_info_exchange.snapshot",
      "display_name_zh": "股票基础信息采集",
      "description": "独立交易所采集器插件:采集股票基础信息并写入本地快照层。",
      "collector_plugin_id": "axdata.collector.exchange",
      "dataset_id": "exchange.stock_basic_info_exchange",
      "category": "基础数据",
      "resource_group": "exchange.http",
      "runner_entry": "axdata_collector_exchange.collectors:run_collector",
      "interfaces": [
        "stock_basic_info_exchange"
      ],
      "required_interfaces": [],
      "required_datasets": [],
      "default_schedule": {
        "kind": "manual"
      },
      "default_params": {
        "code": "000001.SZ"
      },
      "output": {
        "layer": "snapshot",
        "formats": [
          "parquet",
          "csv"
        ],
        "supported_formats": [
          "parquet",
          "csv",
          "duckdb"
        ],
        "default_output_path_parts": [
          "snapshot",
          "dataset=exchange.stock_basic_info_exchange"
        ],
        "default_dir_name": "exchange.stock_basic_info_exchange",
        "file_name_template": "{dataset_id}_{run_time}",
        "write_mode": "snapshot",
        "primary_key": [
          "instrument_id"
        ],
        "required_columns": [
          "instrument_id"
        ],
        "snapshot_date_meta_keys": [
          "data_date",
          "snapshot_date",
          "trade_date",
          "publish_date",
          "date"
        ],
        "datasets": [
          {
            "dataset_id": "exchange.stock_basic_info_exchange",
            "table": "exchange_stock_basic_info_exchange",
            "display_name_zh": "股票基础信息",
            "description": "用于查看交易所官方当前股票基础资料，例如名称、板块、行业、地区、上市日期和股本信息；这是当前列表口径，不表示历史某天状态。",
            "layer": "snapshot",
            "primary_key": [
              "instrument_id"
            ],
            "write_mode": "snapshot",
            "fields": [
              {
                "name": "instrument_id",
                "type": "string",
                "description": "AxData 统一证券代码，例如 000001.SZ、600000.SH、430047.BJ。"
              },
              {
                "name": "symbol",
                "type": "string",
                "description": "证券代码，不带交易所后缀，例如 000001。"
              },
              {
                "name": "exchange",
                "type": "string",
                "description": "交易所代码，建议值为 SSE、SZSE、BSE。"
              },
              {
                "name": "asset_type",
                "type": "string",
                "description": "资产类型，本接口固定为 stock。"
              },
              {
                "name": "name",
                "type": "string",
                "description": "证券简称。"
              },
              {
                "name": "security_full_name",
                "type": "string",
                "description": "证券全称；上交所通常提供，其他交易所可能为空。"
              },
              {
                "name": "market_code",
                "type": "string",
                "description": "市场板块代码；上交所、北交所可能提供，没有时为空。"
              },
              {
                "name": "market",
                "type": "string",
                "description": "市场板块名称，例如主板、创业板、科创板、北交所。"
              },
              {
                "name": "industry_code",
                "type": "string",
                "description": "行业代码；上交所通常提供，其他交易所可能为空。"
              },
              {
                "name": "industry",
                "type": "string",
                "description": "行业名称；各交易所口径不同，源端提供时返回。"
              },
              {
                "name": "region_code",
                "type": "string",
                "description": "地区代码；上交所通常提供，其他交易所可能为空。"
              },
              {
                "name": "region",
                "type": "string",
                "description": "地区名称；上交所、北交所可能提供，没有时为空。"
              },
              {
                "name": "company_code",
                "type": "string",
                "description": "公司代码；上交所通常提供，其他交易所可能为空。"
              },
              {
                "name": "company_short_name",
                "type": "string",
                "description": "公司简称；上交所通常提供，其他交易所可能为空。"
              },
              {
                "name": "company_full_name",
                "type": "string",
                "description": "公司法定全称；上交所通常提供，其他交易所可能为空。"
              },
              {
                "name": "company_short_name_en",
                "type": "string",
                "description": "公司英文简称；上交所、北交所可能提供，没有时为空。"
              },
              {
                "name": "company_full_name_en",
                "type": "string",
                "description": "公司英文全称；上交所通常提供，其他交易所可能为空。"
              },
              {
                "name": "listing_status",
                "type": "string",
                "description": "AxData 上市状态，建议值 listed、delisted、suspended、unknown。"
              },
              {
                "name": "list_date",
                "type": "string",
                "description": "上市日期，格式为 YYYYMMDD。"
              },
              {
                "name": "delist_date",
                "type": "string",
                "description": "退市日期，格式为 YYYYMMDD；未退市为空。"
              },
              {
                "name": "total_share",
                "type": "number",
                "description": "总股本，单位：亿股；深交所、北交所通常提供，上交所当前列表可能为空。"
              },
              {
                "name": "float_share",
                "type": "number",
                "description": "流通股本，单位：亿股；深交所、北交所通常提供，上交所当前列表可能为空。"
              },
              {
                "name": "is_profit",
                "type": "string",
                "description": "是否尚未盈利；深交所可能提供，没有时为空。"
              },
              {
                "name": "is_vie",
                "type": "string",
                "description": "是否具有协议控制架构；深交所可能提供，没有时为空。"
              },
              {
                "name": "has_weighted_voting_rights",
                "type": "string",
                "description": "是否具有表决权差异安排；深交所可能提供，没有时为空。"
              },
              {
                "name": "sponsor",
                "type": "string",
                "description": "保荐机构或主办券商；北交所通常提供，其他交易所可能为空。"
              },
              {
                "name": "share_report_date",
                "type": "string",
                "description": "股本数据报告日期，格式 YYYYMMDD；北交所通常提供，其他交易所可能为空。"
              }
            ],
            "default_query_fields": [
              "instrument_id",
              "symbol",
              "name"
            ],
            "default_filter_fields": [
              "instrument_id"
            ],
            "quality_rules": {
              "required_columns": [
                "instrument_id"
              ]
            },
            "storage": {
              "layout": "snapshot",
              "path_parts": [
                "snapshot",
                "dataset=exchange.stock_basic_info_exchange"
              ]
            },
            "default_output_path_parts": [
              "snapshot",
              "dataset=exchange.stock_basic_info_exchange"
            ],
            "formats": [
              "parquet",
              "csv",
              "duckdb"
            ]
          }
        ]
      },
      "quality": {
        "required_columns": [
          "instrument_id"
        ],
        "primary_key": [
          "instrument_id"
        ]
      },
      "asset_class": "stock"
    },
    {
