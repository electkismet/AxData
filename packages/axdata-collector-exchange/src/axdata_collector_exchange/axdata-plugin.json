              "cal_date"
            ],
            "default_filter_fields": [
              "cal_date"
            ],
            "quality_rules": {
              "required_columns": [
                "cal_date"
              ]
            },
            "storage": {
              "layout": "snapshot",
              "path_parts": [
                "snapshot",
                "dataset=exchange.stock_trade_calendar_exchange"
              ]
            },
            "default_output_path_parts": [
              "snapshot",
              "dataset=exchange.stock_trade_calendar_exchange"
            ],
            "formats": [
              "parquet",
