                "name": "trade_date",
                "type": "date",
                "description": "本行对应的目标日期，格式 YYYYMMDD。"
              },
              {
                "name": "instrument_id",
                "type": "string",
                "description": "AxData 统一证券代码，例如 000001.SZ、600000.SH、430047.BJ。"
              },
              {
                "name": "symbol",
                "type": "string",
                "description": "交易所原始证券代码。"
              },
              {
                "name": "exchange",
                "type": "string",
                "description": "交易所代码：SSE、SZSE、BSE。"
              },
              {
                "name": "name",
                "type": "string",
                "description": "证券简称。"
              },
              {
                "name": "market",
                "type": "string",
                "description": "市场板块，例如主板、创业板、科创板、北交所。"
              },
              {
                "name": "list_date",
                "type": "date",
                "description": "上市日期，格式 YYYYMMDD。"
              },
              {
                "name": "delist_date",
                "type": "date",
                "description": "退市日期；未退市为空。"
              },
              {
                "name": "listing_status",
                "type": "string",
                "description": "上市状态：listed 或 delisted。"
              }
            ],
            "default_query_fields": [
              "trade_date",
              "instrument_id",
              "symbol",
              "name"
            ],
            "default_filter_fields": [
              "trade_date",
              "instrument_id"
            ],
            "quality_rules": {
              "required_columns": [
                "trade_date",
                "instrument_id"
              ]
            },
            "storage": {
              "layout": "daily_file",
              "path_parts": [
                "core",
                "table=exchange_stock_historical_list_exchange"
              ]
            },
            "default_output_path_parts": [
              "core",
              "table=exchange_stock_historical_list_exchange"
            ],
            "formats": [
              "parquet",
              "csv",
              "duckdb"
            ],
            "date_field": "trade_date",
            "partition_by": [
              "trade_date"
            ]
          }
        ]
      },
      "quality": {
        "required_columns": [
          "trade_date",
          "instrument_id"
        ],
        "primary_key": [
          "trade_date",
          "instrument_id"
        ],
        "date_field": "trade_date"
      },
      "asset_class": "stock"
    },
